#!/usr/bin/env python3
"""mitom - MitoM, annotation workflow for animal mitochondrial genomes (one command for every step).

Usage: mitom <command> [options]        mitom <command> -h   shows the options of one command

  run                full workflow (input dedup, reorientation, MitoZ/MITOS2 cores, rescue, rRNA HMM
                     fallback, introns, boundary curation, NCBI submission files)      = batch_mitoz.py run
  annotate | reorient | transfer_metadata | replace_organism | dedup
                     single parts of the workflow                                      = batch_mitoz.py <cmd>
  doctor             which external programs are found; --write-config saves them      = mito_env.py doctor
  curate             boundary rules + NCBI names on GenBank files                     = mito_curate.py
  intron             introns (MFannot method)                                         = mito_intron.py
  trna               multi-method tRNA annotation                                     = mito_trna.py
  rescue             add genes MitoZ missed from MITOS2                                = mito_rescue.py
  rrna-hmm           per-phylum 12S/16S HMMs: build / search                           = mito_rrna_hmm.py
  validate           NCBI table2asn validation and submission files                   = ncbi_validate.py

Typical:  mitom doctor
          mitom run -i my_genomes.gb -o out          (clade and genetic code from the GenBank taxonomy)
          mitom run -i contigs.fasta -o out --clade Mollusca --genetic_code 5
"""
import os
import subprocess
import sys
from pathlib import Path

VERSION = "0.9.0"
HERE = Path(os.path.realpath(__file__)).parent
COMMANDS = {
    **{c: ("batch_mitoz.py", [c]) for c in ("run", "annotate", "reorient", "transfer_metadata", "replace_organism", "dedup")},
    "doctor": ("mito_env.py", ["doctor"]),
    "curate": ("mito_curate.py", []),
    "intron": ("mito_intron.py", []),
    "trna": ("mito_trna.py", []),
    "rescue": ("mito_rescue.py", []),
    "rrna-hmm": ("mito_rrna_hmm.py", []),
    "validate": ("ncbi_validate.py", []),
}


def _imports_biopython(py):
    """True when interpreter `py` (Python >= 3.8) can import Biopython."""
    try:
        return subprocess.run([py, "-c", "import sys, Bio; sys.exit(sys.version_info < (3, 8))"],
                              capture_output=True, timeout=120).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def python_with_biopython():
    """The interpreter that runs the scripts: the current one when it imports Biopython, else the python of the
    first conda environment mito_env knows that does (the first python3 on PATH may be a Miniforge base or an
    activated conda env without Biopython); None when there is none."""
    try:
        import Bio  # noqa: F401
        return sys.executable
    except ImportError:
        pass
    sys.path.insert(0, str(HERE))
    import mito_env
    for b in mito_env.env_bins():
        for name in ("python3", "python"):
            py = b / name
            if py.is_file() and os.access(py, os.X_OK) and _imports_biopython(str(py)):
                return str(py)
    return None


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if argv[0] in ("-V", "--version"):
        print(f"MitoM {VERSION}")
        return 0
    if argv[0] not in COMMANDS:
        print(f"mitom: unknown command '{argv[0]}' (mitom -h lists the commands)", file=sys.stderr)
        return 2
    script, pre = COMMANDS[argv[0]]
    py = python_with_biopython()
    if py is None:
        if argv[0] != "doctor":                       # doctor reports the missing Biopython itself
            print(f"Biopython not found for {sys.executable}; run install.sh or pip install biopython",
                  file=sys.stderr)
            return 2
        py = sys.executable
    os.environ["MITOM_LAUNCHER"] = "1"                 # batch_mitoz.py then calls itself `mitom <command>`
    os.execv(py, [py, str(HERE / script), *pre, *argv[1:]])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
